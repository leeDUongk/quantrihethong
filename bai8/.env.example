# File .env THAT do cai-dat.sh sinh ra va KHONG BAO GIO duoc commit.
# File .example nay chi de nguoi khac biet can nhung bien gi.
#
# TAT CA mat khau phai GIONG HET bai 7 -- neu khong, MySQL da khoi tao
# voi mat khau cu se tu choi tai khoan moi va du lieu WordPress cua bai 7
# thanh vo dung.
MSSV=k23
WP_DB=wp_k23
WP_USER=wp_k23
WP_PASSWORD=doi-mat-khau-nay
MYSQL_ROOT_PASSWORD=doi-mat-khau-nay
EXPORTER_USER=exporter_k23
EXPORTER_PASSWORD=doi-mat-khau-nay
GRAFANA_USER=admin
GRAFANA_PASSWORD=doi-mat-khau-nay
BIND_ADDR=127.0.0.1      # hoac 0.0.0.0 neu chay ./cai-dat.sh <MSSV> --mo-lan
HOST_UID=1000            # id -u  -- de mysql-exporter doc duoc my.cnf che do 600
HOST_GID=1000            # id -g

# Hai bien duoi CHI can khi dung ./cai-dat.sh <MSSV> --telegram.
# De trong thi chi dung bo nhan canh bao noi bo o http://localhost:5001
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
